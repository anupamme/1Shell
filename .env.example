# 1Shell - 环境变量配置

# ===== OpenAI 兼容 API 配置 =====
# 填写你的第三方 API 基础地址（不含 /chat/completions）
OPENAI_API_BASE=https://api.openai.com/v1

# 填写你的 API Key
OPENAI_API_KEY=replace-with-your-api-key

# 使用的模型名称
OPENAI_MODEL=gpt-4o

# ===== Web 控制台登录配置 =====
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=change-me-before-first-run

# 登录会话有效期（小时）
APP_SESSION_TTL_HOURS=12

# 凭据加密密钥：个人首次运行可留空；长期保存服务器密码/私钥前建议设置。
# APP_SECRET=replace-with-a-long-random-app-secret

# ===== 服务器配置 =====
PORT=3301

# ===== V6 Bridge & MCP 配置 =====
# Bridge Token：用于内部 API 鉴权（/api/internal/bridge/exec 和 /mcp/* 端点）
# 留空会在首次启动时自动生成并保存到 data/bridge-token.json。
BRIDGE_TOKEN=

# Bridge 命令执行超时（毫秒），默认 30000
# BRIDGE_EXEC_TIMEOUT_MS=30000

# ===== API 代理访问控制 =====
# /api/proxy 默认仅允许 localhost 访问；远程 CLI/反代调用需设置此 token
# PROXY_TOKEN=replace-with-a-long-random-proxy-token

# ===== 反向代理配置 =====
# 只有来自本机或这些可信代理 IP 的 X-Forwarded-* 头会被用于识别真实协议/来源。
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# ===== V6 Agent Provider 配置 =====
# 默认 Agent Provider（claude-code / opencode / codex）
# AGENT_DEFAULT_PROVIDER=claude-code

# ===== 日志配置 =====
# 日志级别：debug / info / warn / error
# LOG_LEVEL=info

# ===== 探针配置 =====
# 探针超时毫秒数（默认 12000）
# PROBE_TIMEOUT_MS=12000
# 探针轮询间隔毫秒数（默认 60000）
# PROBE_INTERVAL_MS=60000
# 远程探针并发数（默认 3）
# PROBE_REMOTE_CONCURRENCY=3
