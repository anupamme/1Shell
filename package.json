{
  "name": "1shell",
  "version": "4.2.4",
  "description": "1Shell - AI-assisted VPS and server management console",
  "homepage": "https://github.com/weidu12123/1Shell",
  "repository": {
    "type": "git",
    "url": "https://github.com/weidu12123/1Shell.git"
  },
  "bugs": {
    "url": "https://github.com/weidu12123/1Shell/issues"
  },
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "desktop:prepare": "npm --prefix frontend run build",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder",
    "desktop:build:dir": "electron-builder --dir",
    "desktop:build:win": "electron-builder --win",
    "desktop:build:linux": "electron-builder --linux",
    "desktop:build:mac": "electron-builder --mac",
    "build:agent": "node scripts/build-agent.js",
    "package:macos": "node scripts/package-macos-release.js",
    "test": "node scripts/test-risk-rules.js && node scripts/test-file-service.js && node scripts/test-mcp-core-tools.js && node scripts/test-task-authoring-capability.js && node scripts/test-ai-skill-resolver.js && node scripts/test-ide-empty-response-guard.js && node scripts/test-cli-sandbox-snapshot.js && node scripts/test-cli-sandbox-zero-code-manifest.js"
  },
  "keywords": [
    "ssh",
    "web-terminal",
    "devops",
    "ai",
    "mcp",
    "server-management",
    "agentless"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.1.0",
    "socket.io": "^4.7.5",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.4"
  },
  "build": {
    "appId": "com.oneshell.app",
    "productName": "1Shell",
    "asar": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "weidu12123",
        "repo": "1Shell"
      }
    ],
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "desktop/**/*",
      "server.js",
      "src/**/*",
      "lib/**/*",
      "bin/**/*",
      "agent/**/*",
      "public/**/*",
      "frontend/public/favicon.png",
      "frontend/dist/**/*",
      "data/skills/**/*",
      "runtime/node/**/*",
      ".env.example",
      "install.sh",
      "LICENSE",
      "README.md",
      "package.json"
    ],
    "win": {
      "artifactName": "1shell-desktop-${version}-windows-${arch}.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "1shell-desktop-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "artifactName": "1shell-desktop-${version}-macos-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "artifactName": "1shell-desktop-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
